# tyxen-server configuration — copy this file to .env (git-ignored) next to
# server.cjs, then start the server as usual:   node server.cjs
#
# Step 1 — generate the admin key. The password is taken from the environment
# so it never lands in argv or shell history:
#
#   ADMIN_USER=yourname ADMIN_NEW_PASSWORD='a-long-random-secret' node server.cjs --make-key
#
# Step 2 — paste the printed ADMIN_USER and ADMIN_KEY below and restart.
#
# If ADMIN_USER or ADMIN_KEY is empty, /admin login is disabled completely.
# There is no built-in fallback credential any more — the one that used to be
# compiled into server.cjs was readable by anyone who could see the repo.

# Login name, and its key in the form scrypt$N$r$p$salt$hash.
ADMIN_USER=
ADMIN_KEY=

# How many reverse-proxy hops sit in front of this server.
#   0 = identify callers by TCP peer address; X-Forwarded-For is ignored.
#   1 = one rewriting proxy (nginx / Caddy) in front.
#   2 = CDN plus proxy (e.g. Cloudflare -> nginx).
# Only set this to the true hop count. Left at 0 behind a proxy, the admin IP
# allowlist keys on the proxy's address instead of the visitor's.
TRUST_PROXY_HOPS=0

# Failed admin logins tolerated before the escalating per-IP lockout begins.
# A single typo no longer costs 30 seconds.
ADMIN_FAIL_GRACE=5

# Ceiling for a jar upload body (base64-encoded). A ~8 MB jar needs far less.
MAX_UPLOAD_BODY_BYTES=33554432

# Minimum interval between database writes for the same ping caller+username.
# Extra pings inside the window still answer {ok:true}; they just skip the disk.
PING_MIN_INTERVAL_MS=30000

# Admin session lifetime in ms (default 8 hours, was 12).
SESSION_TTL_MS=28800000

# Listen port for the backend itself.
SERVER_PORT=8787
