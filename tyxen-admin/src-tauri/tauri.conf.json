{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tyxen Admin",
  "version": "0.1.0",
  "identifier": "com.tyxen.admin",
  "build": {
    "frontendDist": "../admin-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Tyxen Admin",
        "width": 720,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http: https: data: blob:; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http: https: ws: wss: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Utility"
  }
}
